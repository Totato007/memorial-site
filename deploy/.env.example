# 纪念站 - 环境变量配置模板
# 部署时复制为 .env 并填入真实值

# === 服务端口 ===
PORT=8080

# === 数据库路径 ===
DB_PATH=data/memorial.db

# === 上传目录 ===
UPLOAD_DIR=uploads

# === JWT 密钥 (务必修改为随机字符串) ===
# 生成方法: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# === 管理员账号 (首次启动自动创建) ===
ADMIN_USER=admin
ADMIN_PASS=admin123

# === 图片压缩配置 (按需调整) ===
# 可在 config/config.go 中修改以下默认值:
#   MaxImgSize:  2MB  - 最大上传图片字节数
#   ImgMaxWidth: 800  - 压缩后图片最长边像素
#   ImgQuality:  75   - JPEG 压缩质量 (1-100, 建议 65-85)

# === Gin 运行模式 ===
# 生产环境务必设为 release
GIN_MODE=release
